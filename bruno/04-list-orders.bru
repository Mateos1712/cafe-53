meta {
  name: List recent orders
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/orders
  body: none
  auth: none
}

tests {
  test("Recent orders are returned", function () {
    expect(res.status).to.equal(200);
    expect(res.body.orders).to.be.an("array");
  });

  test("Customer names are not exposed", function () {
    const firstOrder = res.body.orders[0] || {};
    expect(firstOrder).to.not.have.property("customerName");
  });
}
